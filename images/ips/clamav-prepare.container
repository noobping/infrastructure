[Unit]
Description=Prepare clamav state with restricted Ansible policy
DefaultDependencies=no
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service
Wants=systemd-tmpfiles-setup.service
Before=clamav-freshclam.service clamd@scan.service clamav-clamonacc.service

[Container]
ContainerName=infrastructure-policy-clamav
Rootfs=/usr/lib/infrastructure-policy/rootfs
Exec=/usr/bin/infrastructure-policy apply clamav --root /host
Network=none
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_CHOWN
AddCapability=CAP_DAC_OVERRIDE
AddCapability=CAP_FOWNER
PidsLimit=128
SecurityLabelDisable=true
Volume=/etc/passwd:/host/etc/passwd:ro
Volume=/etc/group:/host/etc/group:ro
Volume=/usr/share/clamav:/host/usr/share/clamav:ro
Volume=/var/lib/clamav:/host/var/lib/clamav:rw
Volume=/var/log/clamav:/host/var/log/clamav:rw
Volume=/run/clamd.scan:/host/run/clamd.scan:rw

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=10min
ExecStartPost=-/usr/sbin/restorecon -RF /var/lib/clamav /var/log/clamav /run/clamd.scan
ExecStartPost=/usr/bin/sh -c 'if /usr/sbin/selinuxenabled; then /usr/sbin/setsebool antivirus_can_scan_system on; fi'

[Install]
WantedBy=multi-user.target

[Quadlet]
DefaultDependencies=false
