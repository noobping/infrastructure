# cdrom_id in 60-cdrom_id.rules supplies ID_MODEL/ID_CDROM. Never run a rip in udev.
# Access is limited to the standard optical-drive group and this ASUS USB drive at sr0.
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="sr0", ENV{ID_BUS}=="usb", ENV{ID_CDROM}=="1", ENV{ID_MODEL}=="*BW-16D1HT*", GROUP="cdrom", MODE="0660"
