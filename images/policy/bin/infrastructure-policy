#!/usr/bin/python3
"""Stable CLI for the bundled, offline Ansible policy."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(prog="infrastructure-policy")
    parser.add_argument("command", choices=("apply", "check", "list", "version"))
    parser.add_argument("profile", nargs="?", choices=("workstation", "sway", "nas", "clamav", "suricata", "gssproxy"))
    parser.add_argument("--root", default="/host")
    parser.add_argument("--report-managed", action="store_true")
    arguments = sys.argv[1:]
    aliases = {"--version": "version", "-V": "version", "help": "--help"}
    if arguments:
        arguments[0] = aliases.get(arguments[0], arguments[0])
    args = parser.parse_args(arguments)
    if args.command in ("list", "version"):
        if args.profile or args.report_managed:
            parser.error("this command takes no profile or report option")
        if args.command == "list":
            print("workstation\nsway\nnas\nclamav\nsuricata\ngssproxy")
        else:
            version_file = Path("/usr/lib/infrastructure-policy/version")
            version = os.environ.get("INFRASTRUCTURE_POLICY_VERSION") or (
                version_file.read_text().strip() if version_file.exists() else "dev"
            )
            print(f"infrastructure-policy {version}")
        return 0
    if not args.profile:
        parser.error("missing profile")
    if args.report_managed and args.profile in ("clamav", "suricata", "gssproxy"):
        parser.error("service profiles use native relabeling, not --report-managed")
    if args.report_managed and args.command != "apply":
        parser.error("--report-managed is only valid with apply")
    if not os.path.isabs(args.root) or not os.path.isdir(args.root):
        parser.error("--root must be an existing absolute directory")

    # In a checkout, use the sibling playbook; installed images use /usr/lib.
    bundle = Path(__file__).resolve().parent.parent / "ansible"
    if not bundle.is_dir():
        bundle = Path("/usr/lib/infrastructure-policy/ansible")
    with tempfile.TemporaryDirectory(prefix="infrastructure-policy-") as temporary:
        runtime = Path(temporary)
        variables = runtime / "vars.json"
        variables.write_text(json.dumps({
            "policy_root": os.path.realpath(args.root),
            "policy_profile": "workstation" if args.profile == "sway" else args.profile,
            "policy_report_managed": args.report_managed,
            "ansible_python_interpreter": sys.executable,
        }))
        env = os.environ.copy()
        env.update({
            "ANSIBLE_HOME": str(runtime / "home"),
            "ANSIBLE_CONFIG": str(bundle / "ansible.cfg"),
            "ANSIBLE_LOCAL_TEMP": str(runtime / "local"),
            "ANSIBLE_REMOTE_TEMP": str(runtime / "remote"),
            "ANSIBLE_STDOUT_CALLBACK": "policy",
            "ANSIBLE_CALLBACK_PLUGINS": str(bundle / "callback_plugins"),
            "ANSIBLE_NOCOLOR": "1",
            "ANSIBLE_DEBUG": "0",
            "ANSIBLE_VERBOSITY": "0",
            "POLICY_STATUS_FILE": str(runtime / "status.json"),
            "POLICY_CHECK": "1" if args.command == "check" else "0",
        })
        command = ["ansible-playbook", "-i", "localhost,", "-c", "local",
                   str(bundle / ("service-state.yml" if args.profile in ("clamav", "suricata", "gssproxy") else "site.yml")),
                   "--extra-vars", f"@{variables}"]
        if args.command == "check":
            command.append("--check")
        completed = subprocess.run(command, env=env, cwd=bundle, check=False)
        if completed.returncode or not (runtime / "status.json").exists():
            return 2
        status = json.loads((runtime / "status.json").read_text())
        return int(args.command == "check" and status["changed"] > 0)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"infrastructure-policy: {error}", file=sys.stderr)
        sys.exit(2)
