[Unit]
Description=Install ChatGPT with Codex from OpenAI
Documentation=https://learn.chatgpt.com/docs/linux/linux-app
Wants=network-online.target
After=network-online.target
Before=rpm-ostree-upgrade.service
ConditionPathExists=/run/ostree-booted
ConditionPathExists=/usr/bin/rpm-ostree
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/infrastructure/chatgpt-install
Restart=on-failure
RestartSec=10min
TimeoutStartSec=1h
RuntimeDirectory=chatgpt-installer
RuntimeDirectoryMode=0700
CacheDirectory=chatgpt-installer
CacheDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
