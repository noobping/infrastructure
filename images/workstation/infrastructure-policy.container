[Unit]
Description=Apply restricted Workstation host policy
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service
Wants=systemd-tmpfiles-setup.service
Before=display-manager.service nut-monitor.service sshd.service systemd-user-sessions.service
RequiresMountsFor=/var/home

[Container]
ContainerName=infrastructure-policy-workstation
Rootfs=/usr/lib/infrastructure-policy/rootfs
Exec=/usr/bin/infrastructure-policy apply workstation --root /host --report-managed
Network=none
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_CHOWN
AddCapability=CAP_DAC_OVERRIDE
AddCapability=CAP_FOWNER
PidsLimit=128
SecurityLabelDisable=true
Volume=/etc/passwd:/host/etc/passwd:ro
Volume=/etc/group:/host/etc/group:ro
Volume=/etc/skel:/host/etc/skel:ro
Volume=/etc/ups:/host/etc/ups:rw
Volume=/run/infrastructure-policy:/host/run/infrastructure-policy:rw
Volume=/var/home:/host/var/home:rw

[Service]
Type=oneshot
RuntimeDirectory=infrastructure-policy
RuntimeDirectoryMode=0700
TimeoutStartSec=10min
ExecStartPost=:/usr/bin/bash -ceu 'while IFS= read -r -d "" path; do case "$path" in *//*|*/./*|*/../*|*/.|*/..) echo "unsafe managed path: $path" >&2; exit 1 ;; esac; parent=${path%%/*}; base=${path##*/}; canonical_parent=$(/usr/bin/realpath -e -- "$parent") || { echo "missing managed parent: $parent" >&2; exit 1; }; candidate=${canonical_parent%%/}/$base; case "$path" in /etc/ups|/etc/ups/*) case "$candidate" in /etc/ups|/etc/ups/*) ;; *) echo "redirected NUT relabel path: $path" >&2; exit 1 ;; esac ;; /home/*|/var/home/*) case "$candidate" in /var/home/*) ;; *) echo "redirected home relabel path: $path" >&2; exit 1 ;; esac ;; *) echo "unmanaged relabel path: $path" >&2; exit 1 ;; esac; /usr/sbin/restorecon -F -- "$candidate"; done < /run/infrastructure-policy/managed-paths'
ExecStartPost=:/usr/bin/bash -c 'if ! test -r /etc/ups/netclient.env; then exit 0; elif /usr/bin/systemctl list-unit-files nut-monitor.service --no-legend 2>/dev/null | /usr/bin/grep -q .; then exec /usr/bin/systemctl --no-block restart nut-monitor.service; elif /usr/bin/systemctl list-unit-files nut.target --no-legend 2>/dev/null | /usr/bin/grep -q .; then exec /usr/bin/systemctl --no-block restart nut.target; else echo "no NUT monitor unit is installed" >&2; fi'

[Install]
WantedBy=multi-user.target

[Quadlet]
DefaultDependencies=false
