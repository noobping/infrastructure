#!/usr/bin/python3
"""Read-only local GitLab activity; never contact Caddy or a wake listener."""
import json
from pathlib import Path
import stat
import subprocess
import urllib.parse
import urllib.request


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, message, headers, url):
        return None


def count(value):
    if type(value) is not int or value < 0:
        raise ValueError('Invalid activity counter')
    return value


def sidekiq_idle(data):
    queues, processes = data['queues'], data['processes']
    if not isinstance(queues, dict) or not isinstance(processes, list) or not processes:
        raise ValueError('Missing Sidekiq evidence')
    return (not any(count(v['backlog']) for v in queues.values())
            and not any(count(v['busy']) for v in processes)
            and count(data['jobs']['enqueued']) == 0)


def ci_idle(pages):
    job_states = ('pending', 'running', 'preparing', 'waiting_for_resource')
    pipeline_states = ('created', 'waiting_for_resource', 'preparing',
                       'waiting_for_callback', 'pending', 'running', 'canceling')
    query = urllib.parse.urlencode([('scope[]', state) for state in job_states])
    for project in pages('/api/v4/projects?simple=true'):
        prefix = f'/api/v4/projects/{int(project["id"])}'
        if any(pages(prefix+'/jobs?'+query)):
            return False
        # Include bridges/child pipelines even when they have no ordinary jobs yet.
        # Scheduled and manual pipelines can wait persistently while the VM sleeps.
        for state in pipeline_states:
            for source in ('', '&source=parent_pipeline'):
                if any(pages(prefix+f'/pipelines?status={state}'+source)):
                    return False
    return True


def main():
    key_file = Path('/etc/infrastructure/vm-idle-api-key')
    info = key_file.stat()
    if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError('Monitoring token must be root:0600')
    key = key_file.read_text().strip()
    if not key or '\n' in key:
        raise ValueError('Invalid monitoring token')
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())

    def get(path):
        request = urllib.request.Request('http://127.0.0.1:8080'+path,
                                         headers={'PRIVATE-TOKEN': key, 'Host': 'git.vm'})
        with opener.open(request, timeout=4) as response:
            if response.geturl() != request.full_url:
                raise ValueError('Unexpected API redirect')
            return json.load(response)

    def pages(path):
        page = 1
        while True:
            data = get(path+('&' if '?' in path else '?')+f'per_page=100&page={page}')
            if not isinstance(data, list):
                raise ValueError('Invalid paginated response')
            yield from data
            if len(data) < 100:
                return
            page += 1
            if page > 1000:
                raise ValueError('Activity enumeration exceeds bound')

    health = json.loads(subprocess.run(['podman', 'exec', 'gitlab',
        '/opt/gitlab/embedded/bin/curl', '-fsS', '--max-time', '5',
        'http://127.0.0.1:8080/-/readiness?all=1'], capture_output=True, text=True, check=True, timeout=8).stdout)
    if health.get('status') != 'ok':
        raise ValueError('GitLab dependencies are not ready')
    # read_api administrator token is required: a normal user's project list is incomplete.
    if get('/api/v4/user').get('is_admin') is not True:
        raise ValueError('Monitoring requires administrator visibility')
    idle = ci_idle(pages)
    safe = sidekiq_idle(get('/api/v4/sidekiq/compound_metrics'))
    result = subprocess.run(['podman', 'exec', 'gitlab', 'gitlab-psql', '-d', 'gitlabhq_production',
                             '-At', '-v', 'ON_ERROR_STOP=1', '-c',
                             "SELECT count(*) FROM pg_stat_activity WHERE pid <> pg_backend_pid() AND xact_start IS NOT NULL"],
                            capture_output=True, text=True, check=True, timeout=5)
    safe = safe and count(int(result.stdout.strip())) == 0
    print(json.dumps({'idle': idle, 'safe_to_stop': safe and idle}))


if __name__ == '__main__':
    main()
