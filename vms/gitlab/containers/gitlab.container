[Unit]
Description=GitLab Community Edition
Requires=gitlab-prepare.service
After=gitlab-prepare.service network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/infrastructure/backup/gitlab/restoring
StartLimitIntervalSec=0
[Container]
Image=docker.io/gitlab/gitlab-ce:19.4.2-ce.0@sha256:b65c3ece044d125254b4c4a99b10676bbd2502f05f8c628cb60628f44f4df11b
ContainerName=gitlab
HostName=gitlab.vm
Volume=/var/lib/gitlab/config:/etc/gitlab:Z
Volume=/var/lib/gitlab/data:/var/opt/gitlab:Z
Volume=/var/lib/gitlab/logs:/var/log/gitlab:Z
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:5050:5050
PublishPort=2222:22
ShmSize=256m
PidsLimit=4096
NoNewPrivileges=true
DropCapability=all
AddCapability=CHOWN DAC_OVERRIDE FOWNER FSETID SETGID SETUID NET_BIND_SERVICE SYS_CHROOT KILL
HealthCmd=/opt/gitlab/embedded/bin/curl --fail --silent --max-time 5 http://127.0.0.1:8080/-/readiness
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=900s
HealthRetries=5
StopTimeout=600
LogDriver=journald
[Service]
ExecStopPost=/usr/bin/rm -f /run/gitlab-ready
ExecStartPost=/usr/libexec/infrastructure/gitlab-bootstrap
Restart=on-failure
RestartSec=30
TimeoutStartSec=1200
TimeoutStopSec=660
MemoryMax=14G
CPUQuota=800%
[Install]
WantedBy=multi-user.target
