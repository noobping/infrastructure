ARG IMAGE_NAMESPACE=ghcr.io/noobping
ARG TAG=latest
FROM ${IMAGE_NAMESPACE}/vm:${TAG}
LABEL org.opencontainers.image.title="GitLab Community Edition VM"
COPY containers /etc/containers/systemd
COPY gitlab-prepare.service /etc/systemd/system/
COPY frontend/prepare.service /etc/systemd/system/gitlab-frontend-prepare.service
COPY frontend/Caddyfile /usr/share/gitlab-frontend/Caddyfile
COPY --chmod=0755 frontend/prepare /usr/libexec/infrastructure/gitlab-frontend-prepare
COPY gitlab.rb bootstrap.rb version /usr/share/gitlab/
COPY --chmod=0755 bin/ /usr/libexec/infrastructure/
COPY gitlab.nft /etc/nftables/rules/20-gitlab.nft
RUN systemctl enable vm-idle-report@gitlab.timer; \
    mkdir -p /etc/systemd/system/vm-idle-report@gitlab.service.d; \
    printf '[Service]\nTimeoutStartSec=80s\n' > /etc/systemd/system/vm-idle-report@gitlab.service.d/timeout.conf
RUN grep -qF 'include "/etc/nftables/rules/*.nft"' /etc/nftables/main.nft \
    || sed -i '/tcp dport @allowed_tcp_dports accept/i\        include "/etc/nftables/rules/*.nft"' /etc/nftables/main.nft
RUN if test -d /sysroot/ostree/repo; then ostree container commit; fi
RUN if ! test -d /sysroot/ostree/repo; then bootc container lint; fi
