#!/usr/bin/bash
set -euo pipefail
# Guest-local persistent storage, separate from Omnibus's private :Z mount.
install -d -m 0700 /var/lib/gitlab/frontend
install -d -m 0700 -o 65532 -g 65532 /var/lib/gitlab/frontend/data
install -d -m 0755 /etc/gitlab-frontend
install -m 0644 /usr/share/gitlab-frontend/Caddyfile /etc/gitlab-frontend/Caddyfile
