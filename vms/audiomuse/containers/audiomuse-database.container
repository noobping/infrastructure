[Unit]
Description=AudioMuse PostgreSQL 15 on the local VM disk
Requires=audiomuse-prepare.service
After=audiomuse-prepare.service
StartLimitIntervalSec=0

[Container]
Image=docker.io/library/postgres:15.18-alpine@sha256:3d0f7584ed7d04e27fa050d6683a74746608faf21f202be78460d679cc56461f
ContainerName=audiomuse-database
Network=audiomuse.network
NetworkAlias=database
User=70
Group=70
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=/var/lib/audiomuse/database.env
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Volume=audiomuse-postgres.volume:/var/lib/postgresql/data:U
ReadOnly=true
Tmpfs=/var/run/postgresql:mode=1777
ShmSize=256m
PidsLimit=256
HealthCmd=pg_isready -h 127.0.0.1 -U audiomuse -d audiomusedb
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=5
Notify=healthy
StopTimeout=120

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900
TimeoutStopSec=180
MemoryMax=2G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
