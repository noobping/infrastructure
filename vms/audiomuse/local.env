# Upstream imports these on first boot; later changes belong in Setup Wizard.
TZ=Europe/Amsterdam
POSTGRES_HOST=database
POSTGRES_PORT=5432
AUTH_ENABLED=true
AI_MODEL_PROVIDER=NONE
CLAP_ENABLED=true
LYRICS_ENABLED=false
LYRICS_API_ENABLE=false
PLUGINS_ENABLED=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
TEMP_DIR=/state/temp_audio
IVF_DISK_CACHE_DIR=/state/ivf_cache
CLAP_OTHER_FEATURES_CACHE_DIR=/state/model_cache
FLASK_HTTPS_CERT_DIR=/state/tls
PLUGINS_DIR=/state/plugins
HOME=/state
PYTHONDONTWRITEBYTECODE=1
