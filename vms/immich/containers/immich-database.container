[Unit]
Description=Immich PostgreSQL with VectorChord on the VM disk
Requires=immich-prepare.service
After=immich-prepare.service
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
ContainerName=immich-database
Network=immich.network
NetworkAlias=database
EnvironmentFile=/var/lib/immich/database.env
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Volume=immich-postgres.volume:/var/lib/postgresql/data
ShmSize=128m
HealthCmd=pg_isready -U postgres -d immich
HealthInterval=15s
HealthStartPeriod=60s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy
StopTimeout=120

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
