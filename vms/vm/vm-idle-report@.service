[Unit]
Description=Report whether %i applications are idle
After=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/rm -f /run/vm-on-demand/idle.json
ExecStart=/usr/libexec/infrastructure/vm-idle-check %i --report
TimeoutStartSec=25s
RuntimeDirectory=vm-on-demand
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
